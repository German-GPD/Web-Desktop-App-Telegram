<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Telegram</AssemblyName>
    <RootNamespace>Telegram.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Authors>German-GPD</Authors>
    <Product>Telegram Desktop</Product>
    <Description>Native Windows shell for the official Telegram website.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Content Include="$(ApplicationIcon)" Link="Telegram.ico" CopyToOutputDirectory="PreserveNewest"
             Condition="'$(ApplicationIcon)' != '' and Exists('$(ApplicationIcon)')" />
  </ItemGroup>
</Project>
