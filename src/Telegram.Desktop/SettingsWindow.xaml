<Window x:Class="Telegram.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telegram Desktop — Настройки" Width="760" Height="700"
        MinWidth="680" MinHeight="620" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#F4F6F4"
        Foreground="#202820" FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#229ED9"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D9E0DA"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#202820"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,7,0,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Настройки" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="Настрой приложение под себя — изменения сохраняются на этом устройстве."
                       Foreground="#68746B" Margin="0,5,0,0" FontSize="13"/>
        </StackPanel>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Внешний вид" Padding="16,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,18,8,10">
                        <Border Background="White" BorderBrush="#E0E5E0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Тема приложения" Style="{StaticResource SectionTitle}"/>
                                <ComboBox x:Name="ThemeBox" Height="36" SelectedIndex="0">
                                    <ComboBoxItem Content="Как в Windows" Tag="System"/>
                                    <ComboBoxItem Content="Светлая" Tag="Light"/>
                                    <ComboBoxItem Content="Тёмная" Tag="Dark"/>
                                </ComboBox>
                                <TextBlock Text="Меняет оформление оболочки и цветовую схему сайта, если сайт поддерживает её."
                                           Foreground="#758078" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#E0E5E0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel><TextBlock Text="Масштаб сайта" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ZoomLabel" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></DockPanel>
                                <Slider x:Name="ZoomSlider" Minimum="0.8" Maximum="1.5" Value="1" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True" ValueChanged="ZoomSlider_ValueChanged"/>
                                <TextBlock Text="От 80% до 150%. Можно также менять масштаб сочетаниями Ctrl + и Ctrl − на сайте."
                                           Foreground="#758078" FontSize="11" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                        
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Верхняя панель" Padding="16,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,18,8,10">
                        <Border Background="White" BorderBrush="#E0E5E0" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Порядок кнопок" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Выбери кнопку и перемещай её стрелками. Порядок сразу отразится в верхней панели."
                                           Foreground="#758078" FontSize="11" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ListBox x:Name="ToolbarList" Height="230" BorderBrush="#E0E5E0" Padding="4"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Button Content="↑ Выше" Width="92" Margin="0,0,0,8" Click="MoveUp_Click"/>
                                        <Button Content="↓ Ниже" Width="92" Click="MoveDown_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#E0E5E0" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Видимость кнопок" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="ReloadVisible" Content="Обновить страницу"/>
                                <CheckBox x:Name="BrowserVisible" Content="Открыть в браузере"/>
                                <CheckBox x:Name="UpdateVisible" Content="Проверить обновления"/>
                                <CheckBox x:Name="SiteVisible" Content="Мой сайт"/>
                                <CheckBox x:Name="TelegramVisible" Content="Telegram"/>
                                <TextBlock Text="Кнопка настроек и системные кнопки окна всегда остаются доступными."
                                           Foreground="#758078" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Настройки хранятся локально" Foreground="#758078" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Отмена" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Сохранить" Width="120" Background="{StaticResource Accent}" Foreground="White"
                        BorderBrush="{StaticResource Accent}" FontWeight="SemiBold" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>